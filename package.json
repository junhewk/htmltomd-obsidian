{
  "name": "htmltomd-obsidian",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Verified delivery of htmltomd captures into an Obsidian vault.",
  "scripts": {
    "dev": "node esbuild.mjs --watch",
    "build": "tsc --noEmit && node esbuild.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.11.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
